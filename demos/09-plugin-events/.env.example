DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
DSH_MAX_TOKENS=512
DSH_INITIALIZE_TIMEOUT_MS=10000
DSH_HOME=/tmp/dsh-home
DSH_WORKSPACE=/workspace
DSH_PLUGIN_EVENT_FILE=/tmp/dsh-plugin-events.jsonl
DSH_PLUGIN_MAX_TOKENS=321
DSH_EVENT_LIMIT=500
DSH_MAX_PROMPT_LENGTH=20000
PORT=3009
